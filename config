# ============================================================================
# GHOSTTY - ACO terminal
# Font, colours and opacity come from aco-theme
# (~/.config/aco/theme/ghostty/theme); this file only holds behaviour.
# ============================================================================
config-file = ~/.config/aco/theme/ghostty/theme

# Ligatures off: "==", "->" and "!=" always stay separate characters.
font-feature = -calt
font-feature = -liga

command = /usr/bin/zsh
window-decoration = none
gtk-titlebar = false
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
confirm-close-surface = false
mouse-hide-while-typing = true
shell-integration-features = no-cursor
cursor-style = bar
cursor-style-blink = false
